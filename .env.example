# Bills Hub configuration. Copy to .env and fill in — .env is gitignored.

# ── App ─────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
# Public origin of this app. No trailing slash.
PUBLIC_BASE_URL=https://billhub.example.com
SESSION_TTL_DAYS=30
# Hops in front of the app (nginx / load balancer), so req.ip is the real client.
TRUST_PROXY_HOPS=1

# Turns sign-in off entirely: no login page, every request runs as the owner of
# DEFAULT_ACCOUNT_ID (or the only account). Useful while building.
#
# It leaves the app WIDE OPEN, and Bills Hub can submit and approve bills in a
# live Xero — so anyone who reaches the URL can too. The server prints a warning
# on boot and the UI carries a permanent banner. Do not leave it on anywhere
# reachable from the internet.
AUTH_DISABLED=false
# DEFAULT_ACCOUNT_ID=1

# MUST BE THE SAME VALUE AS WAZZOCR'S. Bills Hub reads WazzOCR's encrypted Xero
# refresh token, so a different key simply cannot decrypt it. Copy it from
# WazzOCR's .env — do not generate a new one.
APP_ENCRYPTION_KEY=

# ── Database ────────────────────────────────────────────────────────────────
# Bills Hub has its own database on the SAME DigitalOcean cluster as WazzOCR.
# All Bills Hub tables live in DB_NAME; nothing is added to WazzOCR's schema.
DB_HOST=
DB_PORT=25060
DB_USER=
DB_PASSWORD=
DB_NAME=billhub

# WazzOCR's database on that same cluster. Bills Hub reads its two Xero tables so
# both apps share one Xero grant — a second consent would supersede WazzOCR's
# token and break its pipeline. The Bills Hub DB user needs:
#   GRANT SELECT, UPDATE ON `wazzocr`.`xero_grants`       TO '<billhub user>'@'%';
#   GRANT SELECT           ON `wazzocr`.`xero_connections` TO '<billhub user>'@'%';
# The UPDATE is only the rotated refresh token, which Xero requires on refresh.
WAZZOCR_DB_NAME=wazzocr

DB_POOL_SIZE=10
# DigitalOcean requires verified TLS. Download the CA cert from the database
# page and point at it, or paste it inline as DB_CA_CERT_PEM.
DB_CA_CERT=./certs/do-mysql-ca.crt
# DB_CA_CERT_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# ── Xero ────────────────────────────────────────────────────────────────────
# The same app as WazzOCR, because Bills Hub spends WazzOCR's token. Both values
# must match WazzOCR's .env exactly.
#
# Bills Hub deliberately has NO redirect URI and NO consent flow: Xero supersedes
# the older token set whenever the same Xero user re-authorises the same app, so
# authorising here would sign WazzOCR out. Connect and reconnect in WazzOCR.
# Copy both from WazzOCR's .env — Bills Hub must use the same Xero app.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# Where the UI sends people to connect or reconnect Xero. No trailing slash.
WAZZOCR_URL=https://wazzocr.example.com

# Xero allows 60 calls/min and 5 concurrent calls per organisation. Defaults sit
# just under both; lower them if you see 429s during a full backfill.
XERO_CALLS_PER_MIN=55
XERO_MAX_CONCURRENT=5

# ── Notifications (WhatsApp digest via Wazzup24) ────────────────────────────
# Seeds the digest settings on first run. After that the values live in the
# database (the API key AES-encrypted), and the app is the source of truth — so
# rotating the key means updating it through the API, not just here.
#
# Unlike the Xero grant, a Wazzup channel is not single-use, so Bills Hub having
# its own channel does not interfere with WazzOCR.
WAZZUP_CHANNEL_ID=
WAZZUP_API_KEY=
WAZZUP_SENDER_PHONE=
# Shown at the bottom of every digest as "Open the queue: …".
DIGEST_QUEUE_URL=https://billhub.example.com
# How often the scheduler checks whether a digest is due. 0 disables it.
DIGEST_TICK_SECONDS=60

# ── Sync ────────────────────────────────────────────────────────────────────
# Background pull interval in minutes. 0 disables it (use scripts/sync-bills.js
# from cron instead).
SYNC_INTERVAL_MINUTES=15
SYNC_CONCURRENCY=4
